#!/bin/sh
set -eu

# Keep Debian mirror URLs free of a trailing slash. live-build appends "/dists/..."
# directly when looking up Contents-amd64.gz; a trailing slash creates a // path
# that some Debian CDN edges return as 404.
lb config noauto \
  --ignore-system-defaults \
  --initsystem systemd \
  --mode debian \
  --distribution trixie \
  --architecture amd64 \
  --mirror-bootstrap "http://deb.debian.org/debian" \
  --mirror-chroot "http://deb.debian.org/debian" \
  --mirror-binary "http://deb.debian.org/debian" \
  --binary-image iso-hybrid \
  --debian-installer live \
  --debian-installer-gui true \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends true \
  --apt-secure true \
  --security false \
  --firmware-binary false \
  --firmware-chroot true \
  --iso-application "lyd KDE Debian Live Server" \
  --iso-publisher "lyd KDE Debian Live" \
  --iso-volume "LYD-DEB-SERVER" \
  --bootappend-live "boot=live components username=live hostname=lyd-server" \
  --memtest none
