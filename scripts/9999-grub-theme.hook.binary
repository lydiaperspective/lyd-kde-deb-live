#!/bin/sh
# Apply the Mystical theme to the UEFI GRUB menu in the generated hybrid ISO.
set -eu

GRUB_CFG="binary/boot/grub/grub.cfg"
THEME_DIR="binary/boot/grub/themes/lyd-mystical"

if [ ! -f "$GRUB_CFG" ]; then
  echo "GRUB binary configuration not found at $GRUB_CFG; leaving the BIOS Syslinux menu unchanged."
  exit 0
fi
[ -f "$THEME_DIR/theme.txt" ] || {
  echo "Mystical GRUB theme assets are missing from $THEME_DIR" >&2
  exit 1
}

if grep -q 'lyd-mystical/theme.txt' "$GRUB_CFG"; then
  echo "Mystical GRUB theme already configured."
  exit 0
fi

tmp="$(mktemp)"
awk '
  {
    print
    if (!inserted && ($0 ~ /^[[:space:]]*search .*--set=root/ || $0 ~ /^[[:space:]]*set root=/)) {
      print ""
      print "insmod gfxterm"
      print "insmod png"
      print "loadfont ($root)/boot/grub/themes/lyd-mystical/title.pf2"
      print "loadfont ($root)/boot/grub/themes/lyd-mystical/menu.pf2"
      print "set gfxmode=auto"
      print "terminal_output gfxterm"
      print "set theme=($root)/boot/grub/themes/lyd-mystical/theme.txt"
      inserted=1
    }
  }
  END { if (!inserted) exit 3 }
' "$GRUB_CFG" > "$tmp" || {
  rm -f "$tmp"
  echo "Could not locate the GRUB root assignment in $GRUB_CFG" >&2
  exit 1
}
cat "$tmp" > "$GRUB_CFG"
rm -f "$tmp"
echo "Mystical theme enabled in $GRUB_CFG"
