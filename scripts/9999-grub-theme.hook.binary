#!/bin/sh
# Apply the Mystical theme to the desktop ISO's UEFI GRUB menu.
set -eu

GRUB_CFG="binary/boot/grub/grub.cfg"
THEME_DIR="binary/boot/grub/themes/lyd-mystical"

if [ ! -f "$GRUB_CFG" ]; then
  echo "GRUB binary configuration not found at $GRUB_CFG; leaving the BIOS Syslinux menu unchanged."
  exit 0
fi
[ -f "$THEME_DIR/theme.txt" ] || {
  echo "Mystical GRUB theme assets are missing from $THEME_DIR" >&2
  exit 1
}

if grep -q 'lyd-mystical/theme.txt' "$GRUB_CFG"; then
  echo "Mystical GRUB theme already configured."
  exit 0
fi

tmp="$(mktemp)"
cat > "$tmp" <<'GRUB'
# lyd Mystical graphical boot menu
if insmod gfxterm && insmod png && loadfont "$prefix/themes/lyd-mystical/title.pf2"; then
  loadfont "$prefix/themes/lyd-mystical/menu.pf2"
  set gfxmode=auto
  terminal_output gfxterm
  set theme="$prefix/themes/lyd-mystical/theme.txt"
fi
GRUB
cat "$GRUB_CFG" >> "$tmp"
cat "$tmp" > "$GRUB_CFG"
rm -f "$tmp"
echo "Mystical theme enabled in $GRUB_CFG"
