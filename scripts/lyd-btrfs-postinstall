#!/usr/bin/env bash
# Finish the default Btrfs layout and configure Snapper + GRUB snapshot boot.
set -Eeuo pipefail

LOG_FILE=/var/log/lyd-btrfs-postinstall.log
mkdir -p /var/log
exec > >(tee -a "$LOG_FILE") 2>&1

log() { printf '[lyd-btrfs] %s\n' "$*"; }
fail() { log "ERROR: $*"; exit 1; }

[[ $EUID -eq 0 ]] || fail "Must run as root."
for tool in btrfs findfs blkid python3 snapper update-grub; do
  command -v "$tool" >/dev/null 2>&1 || fail "Required command is missing: $tool"
done
[[ -x /etc/grub.d/41_snapshots-btrfs ]] || fail "grub-btrfs snapshot generator is not installed."
[[ -x /usr/bin/grub-btrfsd ]] || fail "grub-btrfsd is not installed."

ROOT_SPEC="$(awk '$1 !~ /^#/ && $2 == "/" && $3 == "btrfs" { print $1; exit }' /etc/fstab)"
[[ -n "$ROOT_SPEC" ]] || { log "No Btrfs root entry found; preserving the manually selected layout."; exit 0; }
ROOT_DEVICE="$(findfs "$ROOT_SPEC" 2>/dev/null || true)"
[[ -b "$ROOT_DEVICE" ]] || fail "Could not resolve Btrfs root device from $ROOT_SPEC."
ROOT_UUID="$(blkid -s UUID -o value "$ROOT_DEVICE")"
[[ -n "$ROOT_UUID" ]] || fail "Could not read the Btrfs filesystem UUID."

# Snapper must manage a named root subvolume, not the Btrfs top-level tree.
# Debian Installer normally mounts its root as @rootfs. Refuse a top-level
# root rather than creating snapshots in a layout that cannot be rolled back.
ROOT_FSROOT="$(findmnt -n -o FSROOT /)"
[[ -n "$ROOT_FSROOT" && "$ROOT_FSROOT" != "/" ]] || \
  fail "The root filesystem is mounted from the Btrfs top-level tree, not a named subvolume. Expected a layout such as @rootfs; no changes made."

TOP_MOUNT=/run/lyd-btrfs-top
mkdir -p "$TOP_MOUNT"
mount -t btrfs -o subvolid=5 "$ROOT_DEVICE" "$TOP_MOUNT"
cleanup() { mountpoint -q "$TOP_MOUNT" && umount "$TOP_MOUNT"; }
trap cleanup EXIT

# Separate /home and /var from the Snapper-managed root. Keeping /var outside
# the root snapshots is important for booting read-only snapshots with GRUB.
if ! awk '$1 !~ /^#/ && $2 == "/home" { found=1 } END { exit !found }' /etc/fstab; then
  if ! btrfs subvolume show "$TOP_MOUNT/@home" >/dev/null 2>&1; then
    btrfs subvolume create "$TOP_MOUNT/@home"
    cp -a /home/. "$TOP_MOUNT/@home/"
    log "Created @home and copied existing home contents."
  fi
fi

if ! awk '$1 !~ /^#/ && $2 == "/var" { found=1 } END { exit !found }' /etc/fstab; then
  if ! btrfs subvolume show "$TOP_MOUNT/@var" >/dev/null 2>&1; then
    btrfs subvolume create "$TOP_MOUNT/@var"
    cp -a /var/. "$TOP_MOUNT/@var/"
    log "Created @var and copied existing /var contents."
  fi
fi

umount "$TOP_MOUNT"
trap - EXIT

python3 - "$ROOT_UUID" <<'PY'
from pathlib import Path
import sys

uuid = sys.argv[1]
path = Path("/etc/fstab")
lines = path.read_text().splitlines()
root_found = False
home_found = False
var_found = False
updated = []

for line in lines:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        updated.append(line)
        continue
    fields = line.split()
    if len(fields) < 4:
        updated.append(line)
        continue
    if fields[1] == "/" and fields[2] == "btrfs":
        options = [x for x in fields[3].split(",")
                   if x not in {"atime", "relatime", "strictatime"}
                   and not x.startswith("compress=")]
        for option in ("noatime", "compress=zstd:3"):
            if option not in options:
                options.append(option)
        fields[3] = ",".join(options)
        root_found = True
        updated.append("\t".join(fields))
    elif fields[1] == "/home":
        home_found = True
        updated.append(line)
    elif fields[1] == "/var":
        var_found = True
        updated.append(line)
    else:
        updated.append(line)

if not root_found:
    raise SystemExit("Could not update Btrfs root mount options.")
if not home_found:
    updated.append(f"UUID={uuid}\t/home\tbtrfs\tdefaults,noatime,compress=zstd:3,subvol=@home\t0\t0")
if not var_found:
    updated.append(f"UUID={uuid}\t/var\tbtrfs\tdefaults,noatime,compress=zstd:3,subvol=@var\t0\t0")
path.write_text("\n".join(updated) + "\n")
PY

mount -a
findmnt --verify --verbose || fail "The generated fstab failed validation."
log "Configured @home and @var subvolumes and validated /etc/fstab."

# Initialize Snapper only after the root layout and writable /var mount exist.
if [[ ! -e /etc/snapper/configs/root ]]; then
  snapper -c root create-config /
  snapper -c root set-config \
    TIMELINE_CREATE=yes TIMELINE_CLEANUP=yes NUMBER_CLEANUP=yes \
    NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 \
    TIMELINE_LIMIT_HOURLY=10 TIMELINE_LIMIT_DAILY=7 \
    TIMELINE_LIMIT_WEEKLY=4 TIMELINE_LIMIT_MONTHLY=6 \
    TIMELINE_LIMIT_YEARLY=2
  log "Created the Snapper root configuration."
else
  log "Existing Snapper root configuration found; preserving it."
fi

systemctl --root=/ enable snapper-timeline.timer snapper-cleanup.timer grub-btrfsd.service
# Ensure there is at least one snapshot for the initial GRUB menu.
if ! find /.snapshots -mindepth 2 -maxdepth 2 -type d -name snapshot -print -quit | grep -q .; then
  snapper -c root create --description "Initial installation" --userdata "important=yes"
fi
update-grub
log "Snapper timers and grub-btrfsd enabled; GRUB snapshot menu generated."
log "Btrfs/Snapper/GRUB post-install configuration finished."
